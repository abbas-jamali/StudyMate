<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center_vertical" android:orientation="vertical" android:padding="28dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACCOUNT HELP"
            android:textColor="@color/purple" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp"
            android:text="@string/forgot_title" android:textColor="@color/text_primary" android:textSize="30sp"
            android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:layout_marginBottom="26dp" android:text="Enter the email used for your StudyMate account. This assignment simulates recovery locally; no email is sent."
            android:textColor="@color/text_secondary" android:textSize="15sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email address"
            android:textColor="@color/text_primary" android:textStyle="bold" />
        <EditText android:id="@+id/etRecoveryEmail" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginTop="8dp" android:layout_marginBottom="20dp" android:background="@drawable/bg_input"
            android:hint="you@example.com" android:inputType="textEmailAddress" android:singleLine="true" />
        <Button android:id="@+id/btnRecoveryContinue" android:layout_width="match_parent" android:layout_height="56dp"
            android:background="@drawable/bg_button" android:text="Continue" android:textAllCaps="false"
            android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvBackLogin" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:gravity="center" android:padding="12dp" android:text="Back to login"
            android:textColor="@color/purple" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
